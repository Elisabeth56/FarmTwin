cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Models — never commit these
*.gguf
*.bin
model/downloaded/

# SQLite
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Env
.env
.env.local

# Build artifacts
build/
*.log
EOF