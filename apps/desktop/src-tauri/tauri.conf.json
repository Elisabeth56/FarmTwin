{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FarmTwin",
  "version": "0.2.0",
  "identifier": "dev.elisabethnnamani.farmtwin",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @farmtwin/web build",
    "beforeDevCommand": "pnpm --filter @farmtwin/web dev"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../resources/api/": "api/",
      "../resources/llama/": "llama/",
      "../resources/embedder/": "embedder/",
      "../resources/whisper/": "whisper/"
    },
    "category": "Productivity",
    "shortDescription": "Offline farm advice on your laptop",
    "longDescription": "FarmTwin keeps track of your farms, works out crop stages and risks, and answers questions with an AI model that runs on your laptop. No internet needed after setup.",
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "10.15" },
    "windows": {
      "nsis": { "installerHooks": "./windows/hooks.nsh" }
    },
    "linux": { "deb": { "depends": [] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2NDc3ODk3QURDMUQwNTYKUldSVzBNR3RsM2hISnByRGl5T3hZVkMvUTRNd1NHUGNaNGM1UWx1eVhocHllSFpBdUpBQ0JrMHYK",
      "endpoints": ["https://github.com/Elisabeth56/FarmTwin/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
